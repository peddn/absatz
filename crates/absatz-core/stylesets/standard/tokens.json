{
  "id": "standard",
  "name": "Standard",
  "lang": "de",
  "page": { "paper": "a4", "margin_x_mm": 25, "margin_y_mm": 25 },
  "fonts": { "body": "Libertinus Serif", "mono": "DejaVu Sans Mono" },
  "paragraph": {
    "body":  { "name": "Textkörper",    "role": "body",      "size": 11, "leading": 0.65, "spacing": 8, "justify": true },
    "h1":    { "name": "Überschrift 1", "role": "heading",   "level": 1, "size": 22, "color": "#1a1a1a", "bold": true },
    "h2":    { "name": "Überschrift 2", "role": "heading",   "level": 2, "size": 15, "color": "#1f4e79", "bold": true },
    "h3":    { "name": "Überschrift 3", "role": "heading",   "level": 3, "size": 12, "color": "#1f4e79", "bold": true },
    "list":  { "name": "Aufzählung",    "role": "list_item" },
    "quote": { "name": "Zitat",         "role": "quote",     "italic": true, "indent": 18 },
    "note":  { "name": "Hinweis",       "role": "note",      "size": 10, "color": "#444444", "indent": 18 }
  },
  "character": {
    "emphasis": { "name": "Betont", "role": "emphasis" },
    "strong":   { "name": "Stark",  "role": "strong" },
    "code":     { "name": "Code",   "role": "code" }
  }
}
